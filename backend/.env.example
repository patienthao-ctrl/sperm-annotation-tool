BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
SAM3_MODEL_ID=
SAM3_DEVICE=cuda
SAM3_DTYPE=bfloat16
SAM3_TRACK_FRAMES=120
ANOMALY_REVIEW_LOOKBACK_FRAMES=5
# 左右边缘内多少像素视为对象正在正常离场；仅豁免缩小/裁切类异常
ANOMALY_SIDE_EXIT_MARGIN_PX=10
JWT_SECRET=dev-secret-change-me
# 留空时使用 backend/storage；可设置为本机数据盘绝对路径
APP_STORAGE_DIR=
# SQLite 文件路径；Docker 部署建议设为 /data/database/app.db
APP_DB_FILE=

# 日志目录；留空使用 backend/data
APP_DATA_DIR=
# 本机开发默认启用；Docker CPU 模式由 Compose 关闭 AI Tracking
SAM3_ENABLED=true

# 检测模型随源码提供，正常安装 requirements.txt 已包含依赖。
# 留空使用 app/model_assets/head-detector.pt；填写路径可使用自定义权重。
HEAD_DETECTOR_MODEL=
HEAD_DETECTOR_DEVICE=cpu
# 检测阈值：可信头部（起轨、计数）与低分阈值（点选、延续已有轨迹）
HEAD_DETECTOR_CONF=0.30
HEAD_DETECTOR_LOW_CONF=0.10
